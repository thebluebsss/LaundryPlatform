# Server Port & CORS
PORT=3000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Frontend API URL (Required when building Capacitor Mobile Apps, e.g. https://your-domain.com/api)
VITE_API_URL="/api"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Connection
MONGODB_URI="mongodb+srv://..."

# JWT Configurations for Auth Token (REQUIRED in production)
JWT_SECRET="replace-with-strong-random-64-char-secret"

# Payment Webhook HMAC Secret (HMAC-SHA256 verification for /api/laundry-orders/:id/payment-webhook & /api/payment/vietqr/confirm)
PAYMENT_WEBHOOK_SECRET="replace-with-strong-webhook-secret"

# Email Configurations for mail notifications and OTP (Gmail SMTP App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-16-char-gmail-app-password"
EMAIL_PASSWORD="your-16-char-gmail-app-password"

# Twilio Configurations for SMS (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Stripe Payment Configurations
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# VNPay Gateway Configuration
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL=""
VNPAY_RETURN_URL=""
VNPAY_IPN_URL=""

# MoMo Gateway Configuration
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT=""
MOMO_REDIRECT_URL=""
MOMO_IPN_URL=""

# PayOS Gateway Configuration
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYOS_RETURN_URL=""
PAYOS_CANCEL_URL=""

# AI
GROQ_API_KEY=""
