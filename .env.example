# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Database Connection
MONGODB_URI="mongodb+srv://..."

# JWT Configurations for Auth Token
JWT_SECRET="JWT_SECRET_KEY"

# Email Configurations for mail notifications and OTP
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-email-password"

# Twilio Configurations for SMS (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Stripe Payment Configurations
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# VNPay Gateway Configuration
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL=""
VNPAY_RETURN_URL=""
VNPAY_IPN_URL=""

# MoMo Gateway Configuration
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT=""
MOMO_REDIRECT_URL=""
MOMO_IPN_URL=""

# PayOS Gateway Configuration
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""
PAYOS_RETURN_URL=""
PAYOS_CANCEL_URL=""

# AI
GROQ_API_KEY=""
