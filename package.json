{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:app-customer": "VITE_APP_TARGET=customer vite build --outDir dist-customer",
    "build:app-driver": "VITE_APP_TARGET=driver vite build --outDir dist-driver",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-customer dist-driver server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "ELECTRON_START_URL=http://localhost:3000 npx electron electron.js",
    "electron:start": "npm run build && npx electron electron.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@payos/node": "^2.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/react-is": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.7.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.0",
    "qs": "^6.15.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.79.0",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "stripe": "^22.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "vite": "^6.2.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qs": "^6.15.1",
    "@types/react-router-dom": "^5.3.3",
    "@types/recharts": "^1.8.29",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
